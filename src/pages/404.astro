---
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={`Page not found — ${SITE_TITLE}`} description="This page doesn't exist." />
	</head>
	<body>
		<div class="notfound-shell">
			<Header />
			<main class="notfound">
				<span class="notfound-label">404</span>
				<p class="notfound-text">This page doesn't exist.</p>
				<a href="/">Back home</a>
			</main>
		</div>
	</body>
</html>

<style>
	.notfound-shell {
		max-width: 560px;
		margin: 0 auto;
		padding: 0 2rem;
	}
	.notfound {
		padding-top: 3rem;
	}
	.notfound-label {
		font-family: var(--font-ui);
		font-size: 0.9rem;
		font-weight: 500;
		text-transform: uppercase;
		letter-spacing: 0.08em;
		color: var(--text-muted);
		display: block;
		margin-bottom: 0.75em;
	}
	.notfound-text {
		margin: 0 0 1em;
	}
	.notfound a {
		font-family: var(--font-ui);
		font-size: 0.9rem;
		color: var(--accent);
		text-decoration: none;
	}
	.notfound a:hover {
		text-decoration: underline;
	}
</style>
