{
  "name": "personal-site",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "dev:api": "cd worker && npm install --no-audit --no-fund && npx wrangler d1 execute comments --local --file schema.sql && npx wrangler dev",
    "dev:full": "concurrently -k -n site,api \"npm run dev\" \"npm run dev:api\"",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "dependencies": {
    "@astrojs/mdx": "^5.0.1",
    "@astrojs/rss": "^4.0.17",
    "@astrojs/sitemap": "^3.7.1",
    "astro": "^6.0.5",
    "rehype-katex": "^7.0.1",
    "remark-math": "^6.0.0",
    "sharp": "^0.34.3"
  }
}
