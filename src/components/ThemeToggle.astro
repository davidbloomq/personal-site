---
/**
 * Dark mode toggle. Shared by the essay Header, homepage, and feed
 * page headers so the logic can't drift between copies.
 * localStorage is guarded: with storage blocked the toggle still
 * works for the current page view.
 */
---

<button class="theme-toggle" id="theme-toggle" type="button" aria-label="Toggle dark mode">●</button>
<script is:inline>
(function() {
  var btn = document.getElementById('theme-toggle');
  if (!btn) return;
  btn.addEventListener('click', function() {
    var current = document.documentElement.dataset.theme;
    var next = current === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = next;
    try {
      localStorage.setItem('theme', next);
    } catch (e) {
      /* storage unavailable — theme still applies for this page view */
    }
  });
})();
</script>
<style>
  .theme-toggle {
    background: none;
    border: none;
    cursor: pointer;
    font-size: 0.6rem;
    color: var(--text-muted);
    padding: 0;
    line-height: 1;
    transition: color 0.15s ease-in-out;
  }
  .theme-toggle:hover {
    color: var(--accent);
  }
</style>
